# The absolute origin the built site is served from. Everything else lives
# in content/ as a plain constant - this is the one value that differs per
# environment, and sitemap.xml, robots.txt and OpenGraph cannot be relative.
NEXT_PUBLIC_SITE_URL=https://example.com

# The Gmail account the contact form sends through. GMAIL_APP_PASSWORD is a
# 16-character App Password (Google Account > Security > 2-Step Verification >
# App passwords), never the account password: Gmail rejects the real one over
# SMTP. Server-only - no NEXT_PUBLIC_ prefix, so it never reaches the bundle.
# This is the account that SENDS. The recipient is not configured here - it is
# the owner email in content/index.ts, so the two can be different accounts.
# Unset, /api/contact answers 503 and the form points the visitor at the address.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Chat on /questions. Server-only key; unset -> /api/ask answers 503.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Chat question log (Vercel Blob). Connecting a Blob store to the project sets
# BLOB_STORE_ID and the SDK authenticates with OIDC: nothing to add on Vercel.
# OIDC does not work locally; to keep questions in local dev, uncomment the
# store's read-write token. Unset -> questions are not kept.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Any long random string. Vercel Cron sends it to /api/ask/digest, which mails
# the day's questions once and empties the store. Unset -> the digest answers 401.
CRON_SECRET=xxxxxxxxxxxxxxxx
